# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# No model key: since 2026-09-23 no sentence on the site is generated by a
# language model (owner ruling BA-10; src/app/no-model-text.test.ts).

# §26 voice A/B kill-switch. Unset/0 = dormant (everyone gets the classic voice);
# "1" = run the transparent 50/50 online-voice experiment. Smoke-test the live
# voice first, THEN flip this to 1; flip back to 0 to stop it without a rollback.
NEXT_PUBLIC_VOICE_AB=

# Payments — Merchant of Record (spec §24). With the provider unconfigured,
# /api/checkout returns 501 and the paywall offers a dev unlock in non-production
# so the gated report stays testable.
PAYMENTS_PROVIDER=dodo
# Dodo Payments — server-only API key (used to VERIFY the payment on return).
# Use a TEST key first.
DODO_API_KEY=
# The hosted No-Code Payment Link for "Vibe Check — The Full Read" ($3.99),
# copied from the Dodo dashboard. We append redirect_url + metadata to it.
DODO_PAYMENT_LINK=
# "test" (default) or "live" — selects the Dodo API base URL for verification.
DODO_MODE=test

# Public base URL used on share/OG image + Stripe success/cancel URLs (no trailing slash).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Support/contact email shown on /legal (optional — without it, copy points
# users at their Stripe receipt, which also reaches you).
NEXT_PUBLIC_SUPPORT_EMAIL=
